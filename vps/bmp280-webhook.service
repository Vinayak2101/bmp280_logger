[Unit]
Description=BMP280 webhook collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bmp280
Group=bmp280
EnvironmentFile=/etc/default/bmp280-webhook
ExecStart=/usr/bin/python3 /opt/bmp280/webhook.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bmp280

[Install]
WantedBy=multi-user.target