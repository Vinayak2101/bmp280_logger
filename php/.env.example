# BMP280 collector configuration.
# Copy to `.env` next to bmp280.php, or — better — one level ABOVE the web root so the
# file is never served over HTTP. Without a .env the built-in defaults are used.

BMP280_DB_HOST=localhost
BMP280_DB_NAME=bmp280
BMP280_DB_USER=bmp280
BMP280_DB_PASS=change-me

# Shared secret the ESP32 sends as "Authorization: Bearer <token>".
# Generate one with:  openssl rand -hex 24
BMP280_TOKEN=change-me

# --- optional: where the sensor is, and how to show time -------------------
# IANA zone name, used only for display (the database always stores UTC).
BMP280_TZ=Asia/Kolkata
# Free-text label shown in the dashboard header.
BMP280_LOCATION=Jadui Danda, IN
# Station elevation above sea level in metres: enables the sea-level pressure
# correction card. Leave 0 or empty to disable it.
BMP280_ELEV_M=18
# Optional coordinates, shown as a map link in the header.
BMP280_LAT=22.57
BMP280_LON=88.36