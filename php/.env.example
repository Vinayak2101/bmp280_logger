# BMP280 collector configuration.
# Copy to `.env` next to bmp280.php, or — better — one level ABOVE the web root so the
# file is never served over HTTP. Without a .env the built-in defaults are used.

BMP280_DB_HOST=localhost
BMP280_DB_NAME=bmp280
BMP280_DB_USER=bmp280
BMP280_DB_PASS=change-me

# Shared secret the ESP32 sends as "Authorization: Bearer <token>".
# Generate one with:  openssl rand -hex 24
BMP280_TOKEN=change-me